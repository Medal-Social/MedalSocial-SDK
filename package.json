{
  "name": "medalsocial-sdk-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Medal-Social/MedalSocial-SDK.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "test:coverage": "pnpm -r --filter './packages/*' test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "typecheck": "pnpm -r --filter './packages/*' typecheck",
    "quality": "pnpm lint && pnpm typecheck && pnpm test",
    "version": "changeset version && node packages/sdk/scripts/sync-version.mjs",
    "release": "pnpm -r --filter './packages/*' build && pnpm -r --filter './packages/*' verify:paths && changeset publish",
    "changeset": "changeset",
    "knip:report": "knip --reporter json --no-exit-code",
    "knip:check": "knip",
    "secret:scan": "node packages/sdk/scripts/secretlint-repo.mjs",
    "secret:scan:staged": "node packages/sdk/scripts/secretlint-staged.mjs"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "only-allow": "^1.2.2",
    "secretlint": "^13.0.6"
  }
}
