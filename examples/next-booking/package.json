{
  "name": "medalsocial-example-next-booking",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal Next 16 booking site on @medalsocial/booking/next, against a mock Medal — the package's CI smoke target",
  "scripts": {
    "prebuild": "pnpm --filter @medalsocial/booking run build",
    "build": "next build",
    "start": "next start --port 3100",
    "mock:medal": "node mock-medal/server.mjs",
    "check:client": "node scripts/check-client-bundle.mjs --self-test && node scripts/check-client-bundle.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@medalsocial/booking": "workspace:*",
    "@medalsocial/meda": "^3.15.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
