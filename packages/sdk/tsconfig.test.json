{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // scripts/ is plain .mjs — without these two the `scripts` include below
    // silently contributes zero files and the gate is a no-op.
    "allowJs": true,
    "checkJs": true,
    // noEmit, so rootDir only has to contain every checked file, including
    // the repo-wide scripts two levels up.
    "rootDir": "../.."
  },
  // ../../scripts holds the repo-wide secretlint scripts, tested from here.
  "include": ["src", "tests", "pilot", "scripts", "../../scripts"]
}
