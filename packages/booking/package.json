{
  "name": "@medalsocial/booking",
  "version": "0.0.0",
  "description": "Medal Social booking: the wizard rules, clock, money and portal helpers behind a Medal booking site",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.24.0",
  "author": "Medal Social / Ali Aljumaili",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Medal-Social/MedalSocial-SDK.git",
    "directory": "packages/booking"
  },
  "bugs": {
    "url": "https://github.com/Medal-Social/MedalSocial-SDK/issues"
  },
  "homepage": "https://github.com/Medal-Social/MedalSocial-SDK/tree/dev/packages/booking#readme",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.mts",
      "import": "./dist/core/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "import": "./dist/react/index.mjs"
    },
    "./react/wizard": {
      "types": "./dist/react/wizard/index.d.mts",
      "import": "./dist/react/wizard/index.mjs"
    },
    "./react/link": {
      "types": "./dist/react/link/index.d.mts",
      "import": "./dist/react/link/index.mjs"
    },
    "./react/shared": {
      "types": "./dist/react/shared.d.mts",
      "import": "./dist/react/shared.mjs"
    },
    "./next": {
      "types": "./dist/next/index.d.mts",
      "import": "./dist/next/index.mjs"
    },
    "./next/cache/workers": {
      "types": "./dist/next/cache/workers.d.mts",
      "import": "./dist/next/cache/workers.mjs"
    },
    "./next/cache/memory": {
      "types": "./dist/next/cache/memory.d.mts",
      "import": "./dist/next/cache/memory.mjs"
    },
    "./next/cache/next-data": {
      "types": "./dist/next/cache/next-data.d.mts",
      "import": "./dist/next/cache/next-data.mjs"
    },
    "./next/cache/noop": {
      "types": "./dist/next/cache/noop.d.mts",
      "import": "./dist/next/cache/noop.mjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/ensure-sdk-types.mjs && tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "verify:paths": "node scripts/verify-package-paths.mjs && node scripts/verify-core-runtime.mjs",
    "size:budget": "node scripts/size-budget.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "medal",
    "booking",
    "salon",
    "appointments",
    "wizard",
    "typescript"
  ],
  "dependencies": {
    "@medalsocial/sdk": "workspace:^",
    "server-only": "^0.0.1"
  },
  "peerDependencies": {
    "@medalsocial/meda": "^3.3.0",
    "lucide-react": "^1.8.0",
    "next": ">=16.3",
    "react": ">=19",
    "react-dom": ">=19",
    "zod": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "@medalsocial/meda": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@medalsocial/meda": "^3.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.49.0",
    "miniflare": "4.20260730.0",
    "next": "^16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
