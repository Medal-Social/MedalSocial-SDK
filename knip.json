{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "ignoreDependencies": [
        "@commitlint/cli",
        "@secretlint/secretlint-rule-preset-recommend",
        "lint-staged"
      ]
    },
    "packages/sdk": {
      "ignore": ["src/index.ts", "vitest.integration.config.ts"]
    },
    "packages/booking": {
      "entry": ["src/next/cache/*.ts", "scripts/*.mjs"]
    },
    "examples/*": {}
  },
  "ignoreExportsUsedInFile": true,
  "husky": false
}
